#: app/templates/portal.html
msgid "¡Bienvenido a Club Entre Patitas!"
msgstr "Welcome to Club Entre Patitas!"

msgid "Tu plataforma de confianza para el cuidado veterinario"
msgstr "Your trusted platform for veterinary care"

msgid "Selecciona tu tipo de usuario para acceder a las funcionalidades específicas del sistema."
msgstr "Select your user type to access the specific features of the system."

msgid "Nuestro sistema está diseñado para brindar la mejor experiencia tanto a veterinarios como a dueños de mascotas."
msgstr "Our system is designed to provide the best experience for both veterinarians and pet owners."

msgid "Funcionario de Club Entre Patitas"
msgstr "Club Entre Patitas Staff"

msgid "Acceso completo al sistema de gestión de fichas médicas, pacientes y herramientas profesionales."
