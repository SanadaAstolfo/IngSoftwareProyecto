msgid "Crear y gestionar fichas médicas"
msgstr "Create and manage medical records"

msgid "Programar citas y controles"
msgstr "Schedule appointments and checkups"

msgid "Generar reportes médicos"
msgstr "Generate medical reports"

msgid "Acceso completo a la base de datos"
msgstr "Full database access"

msgid "Soy Funcionario de"
msgstr "I am a Staff Member of"

msgid "Dueño de Mascota"
msgstr "Pet Owner"

msgid "Accede al historial médico de tu mascota y mantente informado sobre su salud y tratamientos."
msgstr "Access your pet's medical history and stay informed about their health and treatments."

msgid "Ver historial médico de tu mascota"
msgstr "View your pet's medical history"

msgid "Consultar próximas citas"
msgstr "Check upcoming appointments"

msgid "Seguimiento de tratamientos"
msgstr "Treatment tracking"

msgid "Contacto directo con veterinarios"
msgstr "Direct contact with veterinarians"

msgid "Soy Dueño de Mascota"
msgstr "I am a Pet Owner"

msgid "Pacientes"
